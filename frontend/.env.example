# Exam Scheduling System — Frontend environment variables
#
# Copy this file to .env.local and set values for your environment.
# All variables prefixed with VITE_ are exposed to the browser.
#
# To point the app at a remote server, change VITE_API_BASE_URL:
#   VITE_API_BASE_URL=https://your-server.example.com
# No other changes needed (AQ-4 / P7-T8 server-ready requirement).

VITE_API_BASE_URL=http://localhost:8000
