# Exam Scheduling System — Backend environment variables
#
# Copy this file to .env and set values for your environment.
# All variables have safe defaults for local development.

# Comma-separated allowed CORS origins.
# To host on a remote server, add its origin here:
#   ALLOWED_ORIGINS=https://your-server.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload size in bytes (default: 20 MB = 20971520)
MAX_UPLOAD_BYTES=20971520

# SQLite database directory (default: ./data next to main.py)
# DB_DIR=/path/to/data
